# Server Configuration
PORT=3001
NODE_ENV=production

# Upstash QStash Configuration (get from https://console.upstash.com/qstash)
QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key_here
QSTASH_TOKEN=your_qstash_token_here

# Manual trigger secret (generate a random string)
MANUAL_TRIGGER_SECRET=your_random_secret_here

# Optional: AWS S3 Configuration for data backup
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET=examfinder-data-bucket

# Scraper Configuration
OUTPUT_PATH=/app/data/data.json
LOG_LEVEL=info
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable