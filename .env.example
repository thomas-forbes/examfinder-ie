# AWS Configuration
# These are automatically configured in ECS, but needed for local testing
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Bucket (set by CDK deployment)
S3_BUCKET=examfinder-data-YOUR_ACCOUNT_ID

# Output path for local scraping
OUTPUT_PATH=../../apps/web/public/data.json

# Logging
LOG_LEVEL=info