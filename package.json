{
  "name": "@examfinder/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "pnpm --filter @examfinder/web build",
    "dev": "pnpm --filter @examfinder/web dev",
    "lint": "pnpm --filter @examfinder/web lint",
    "start": "pnpm --filter @examfinder/web start",
    "scrape": "pnpm --filter @examfinder/data scrape",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
