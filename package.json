{
  "name": "@examfinder/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "pnpm --filter @examfinder/web build",
    "dev": "pnpm --filter @examfinder/web dev",
    "lint": "pnpm -r --if-present lint",
    "start": "pnpm --filter @examfinder/web start",
    "scrape": "pnpm --filter @examfinder/data scrape",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "@playwright/test": "^1.64.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34.7 <11"
  }
}
